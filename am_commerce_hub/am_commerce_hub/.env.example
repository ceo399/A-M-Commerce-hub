# A&M Commerce Hub 設定例。これを .env にコピーして値を埋める（.env はGit管理しないこと）。

# --- データベース ---
# 開発: SQLite（既定）。本番: PostgreSQL 例) postgresql+psycopg://user:pass@host:5432/amhub
DATABASE_URL=sqlite:///./am_commerce_hub.db
# 本番でAlembic運用する場合は False にして `alembic upgrade head` で作成
AUTO_CREATE_TABLES=true

# --- 連携モード ---
# mock: すべて模擬（現状）/ live: 実APIを使用（資格情報取得後）
INTEGRATION_MODE=mock

# --- 認証 / JWT ---
# 本番では必ず十分長いランダム値に変更すること（例: openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
OTP_EXPIRE_MINUTES=5
# 開発確認用。モック時のみOTPを応答に表示（本番では必ず false）
DEV_ECHO_OTP=false

# --- ログ ---
LOG_LEVEL=INFO

# --- Docker Compose 用（docker compose が参照） ---
POSTGRES_USER=amhub
POSTGRES_PASSWORD=amhub_pass
POSTGRES_DB=amhub
# uvicornワーカー数（本番でCPUに応じて増やす）
WEB_CONCURRENCY=1

# --- スケジューラ（日次処理の自動化） ---
SCHEDULER_TIMEZONE=Asia/Tokyo
ORDERS_INGEST_CRON=0 * * * *
ADS_COLLECT_CRON=0 6 * * *
CLEANUP_CRON=30 3 * * *

# --- 広告 既定値 ---
TARGET_ACOS=0.20
DAILY_BUDGET_JPY=11000

# --- Amazon 資格情報（取得後に設定） ---
# リージョン: na/eu/fe（日本はfe）
# SP_API_REGION=fe
# ADS_API_REGION=fe
# SP_API_REFRESH_TOKEN=
# SP_API_CLIENT_ID=
# SP_API_CLIENT_SECRET=
# ADS_API_CLIENT_ID=
# ADS_API_CLIENT_SECRET=
# ADS_API_REFRESH_TOKEN=
# ADS_PROFILE_ID=

# --- AI（Claude）取得後に設定 ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-3-5-sonnet-latest
